# ═══════════════════════════════════════════════════════════════════════════════
# 环境变量模板 —— 复制成 .env 再填真实值（.env 已在 .gitignore 里，不会进仓库）
#
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# 只跑主应用（界面 + 预测 + 登录）时，**必须**的只有：
#   DATABASE_URL / SERVER_HOST / SERVER_PORT / DEBUG / UI_REQUIRE_AUTH
# 其余按需填：不填就没有对应的数据源或功能，但服务照样起得来。
# ═══════════════════════════════════════════════════════════════════════════════

# ── 数据库 ────────────────────────────────────────────────────────────────────
# 相对路径以项目根目录为基准；128 MB 左右的 SQLite 单文件，注意放在**持久盘**上
DATABASE_URL=sqlite:///./data/database/football.db

# ── 服务 ──────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# 生产必须 false：true 时 uvicorn 会开 --reload（开发才用）
DEBUG=false

# ── 登录闸门 ──────────────────────────────────────────────────────────────────
# true（默认）= 除公开端点外，所有 /api/ui/* 都要登录；false = 全部放行（仅本地调试用）
UI_REQUIRE_AUTH=true

# ── 注册 / 忘记密码 ───────────────────────────────────────────────────────────
# 是否允许自助注册（新账号固定是普通用户，注册不出管理员）
AUTH_ALLOW_REGISTER=true
# 重置码是否直接回显在页面上：
#   false（默认，公网安全）= 码只写 logs/auth_reset.log + 服务端 stdout，由管理员转告用户
#   true（仅本机自用）= 码直接显示在忘记密码页
AUTH_RESET_SHOW_CODE=false
AUTH_RESET_TTL_MINUTES=10
AUTH_RESET_MAX_TRIES=5

# ── 定时任务（服务启动即生效，不需要单独进程）─────────────────────────────────
# 每 5 分钟拉实时比分
ENABLE_LIVE_SCORE_UPDATE=true
# 每日/每周任务：赛程同步 03:00、赛果与 xG 03:30、身价与转会 05:00、周一 04:00 全量
ENABLE_DAILY_UPDATE=true

# ── 数据源（都是可选的，只影响数据同步，不影响界面读取已有数据）───────────────
# API-Football (RapidAPI) 免费层 100 次/天 —— https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# API-Sports 直连（付费档 7500 次/天）—— https://dashboard.api-football.com
API_SPORTS_KEY=
API_SPORTS_BASE=https://v3.football.api-sports.io
# 每日请求预算与最小间隔（免费档限速 10 次/分钟 → 间隔 6.0；Pro 档 → 0.25）
AF_DAILY_BUDGET=7000
AF_MIN_INTERVAL=6.0

# Football-Data.org（免费，五大联赛赛程/赛果/积分榜）—— https://www.football-data.org
FOOTBALL_DATA_TOKEN=

# 球小策（按点计费：xG / 阵容 / 伤停 / 转会）—— https://www.qiuxiaoce.com
QIXIAOCE_API_KEY=
QIXIAOCE_BASE=https://www.qiuxiaoce.com/wp-json/abv2-creator/v1

# ── LLM（智能问答 /api/ui/ask 用得到；不填也能跑，自动降级为检索摘要）──────────
# 三选一：DeepSeek / 豆包 / 通义千问（都要 OpenAI 兼容接口）
# 留空 = 问答页返回「库内事实 + 检索片段」的检索摘要（mode=retrieval）；
# 填上 key = 自动切到大模型作答（mode=llm，句末带 [n] 引用，见 docs/智能问答说明.md）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
