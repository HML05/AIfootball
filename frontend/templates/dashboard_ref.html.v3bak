<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>足球分析系统</title>
<style>
:root{
  --bg:linear-gradient(165deg,#eef5fd,#dcebfa 30%,#cfe3f7 55%,#dcebfa 78%,#e8f3fc);
  --text:#14335c;--sub:#4a6fa0;
  --acc:linear-gradient(135deg,#5aa2ff,#2e6fe6);--acc-s:#2e7cf0;
  --glow:0 6px 16px rgba(59,130,246,.42);
  --track:rgba(120,160,220,.28);--green:#17b26a;--ring1:#3f8dff;--ring2:#c9e2ff;
  --img-filter:saturate(1.18) contrast(1.06) brightness(.99);
  --veil:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,0) 40%,rgba(255,255,255,.04));
  --dot-y:#f5a83c;--dot-g:#3ecf6e;
  /* ★ 液态玻璃统一配方：全站唯一 */
  --lg-bg:linear-gradient(135deg,rgba(255,255,255,.34) 0%,rgba(255,255,255,.12) 40%,rgba(255,255,255,.08) 58%,rgba(255,255,255,.24) 100%);
  --lg-bd:rgba(255,255,255,.72);
  --lg-blur:blur(10px) saturate(170%);
  --lg-spec:linear-gradient(115deg,rgba(255,255,255,.55) 0%,rgba(255,255,255,.07) 26%,rgba(255,255,255,0) 44%,rgba(255,255,255,.14) 72%,rgba(255,255,255,.40) 100%);
  --lg-out:0 18px 44px rgba(60,120,200,.20),0 2px 8px rgba(60,120,200,.12);
  --lg-inn:inset 0 1.5px 1px rgba(255,255,255,1),
           inset 1.5px 0 1.5px rgba(255,255,255,.65),
           inset -1.5px 0 1.5px rgba(255,255,255,.65),
           inset 0 -2.5px 2px rgba(255,255,255,.5),
           inset 0 10px 24px rgba(255,255,255,.28),
           inset 0 -14px 26px rgba(70,130,210,.14);
  --hair:rgba(255,255,255,.5);
}
body.theme-sunset{
  --bg:radial-gradient(58% 38% at 72% 0%,rgba(255,224,175,.95),transparent 62%),
       radial-gradient(46% 32% at 18% 6%,rgba(255,196,148,.85),transparent 65%),
       radial-gradient(64% 44% at 88% 34%,rgba(255,158,104,.55),transparent 70%),
       linear-gradient(160deg,#f2a06b,#e97f5f 62%,#d97a6e);
  --text:#4e2a0a;--sub:#8a5528;--acc:linear-gradient(135deg,#ffc257,#ee7d2d);--acc-s:#ee8430;
  --glow:0 6px 18px rgba(238,132,48,.55);--track:rgba(125,70,20,.22);--green:#84c53e;
  --ring1:#f6a93b;--ring2:#ffe2a6;
  --img-filter:sepia(.32) saturate(1.55) hue-rotate(-12deg) contrast(1.04);
  --veil:linear-gradient(200deg,rgba(255,170,90,.12),rgba(255,120,60,.03) 55%,rgba(150,60,20,.08));
  --dot-y:#ffb84d;--dot-g:#8fd14f;
  --lg-bg:linear-gradient(135deg,rgba(255,244,214,.40) 0%,rgba(255,222,172,.16) 40%,rgba(255,214,158,.10) 58%,rgba(255,232,190,.28) 100%);
  --lg-bd:rgba(255,250,232,.80);
  --lg-spec:linear-gradient(115deg,rgba(255,252,238,.65) 0%,rgba(255,240,200,.08) 26%,rgba(255,240,200,0) 44%,rgba(255,220,160,.16) 72%,rgba(255,232,180,.42) 100%);
  --lg-out:0 18px 44px rgba(170,85,25,.28),0 0 38px rgba(255,170,85,.34);
  --lg-inn:inset 0 1.5px 1px rgba(255,253,242,1),
           inset 1.5px 0 1.5px rgba(255,246,220,.7),
           inset -1.5px 0 1.5px rgba(255,246,220,.7),
           inset 0 -2.5px 2px rgba(255,244,214,.55),
           inset 0 10px 24px rgba(255,248,224,.32),
           inset 0 -14px 26px rgba(220,120,50,.16);
  --hair:rgba(255,240,210,.55);
}
body.theme-night{
  --bg:linear-gradient(165deg,#0a1730,#0f2547 55%,#0b1e3c);
  --text:#eaf4ff;--sub:#a9c4e4;--acc:linear-gradient(135deg,#22d3ee,#2f6fe6);--acc-s:#38bdf8;
  --glow:0 6px 18px rgba(34,211,238,.5);--track:rgba(255,255,255,.14);--green:#34d399;
  --ring1:#38bdf8;--ring2:#155e9e;
  --img-filter:brightness(.52) saturate(1.2) contrast(1.1);
  --veil:linear-gradient(180deg,rgba(6,16,38,.35),rgba(6,16,38,.1) 50%,rgba(6,16,38,.3));
  --dot-y:#fbbf24;--dot-g:#34d399;
  --lg-bg:linear-gradient(135deg,rgba(90,150,230,.28) 0%,rgba(20,50,100,.14) 40%,rgba(30,70,130,.10) 58%,rgba(50,100,180,.22) 100%);
  --lg-bd:rgba(150,210,255,.45);
  --lg-spec:linear-gradient(115deg,rgba(190,235,255,.30) 0%,rgba(255,255,255,.03) 26%,rgba(255,255,255,0) 44%,rgba(120,200,255,.10) 72%,rgba(150,220,255,.25) 100%);
  --lg-out:0 18px 44px rgba(0,10,30,.55),0 0 28px rgba(34,211,238,.18);
  --lg-inn:inset 0 1.5px 1px rgba(190,235,255,.55),
           inset 1.5px 0 1.5px rgba(150,210,255,.28),
           inset -1.5px 0 1.5px rgba(150,210,255,.28),
           inset 0 -2.5px 2px rgba(140,200,255,.22),
           inset 0 10px 24px rgba(120,190,255,.10),
           inset 0 -14px 26px rgba(0,20,60,.30);
  --hair:rgba(110,180,255,.18);
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{font-family:"PingFang SC","Microsoft YaHei",sans-serif;color:var(--text);
  background:var(--bg);transition:background .6s;overflow:hidden}
.fx span{position:fixed;border-radius:50%;pointer-events:none;z-index:0;transition:all .6s}
.fx span:nth-child(1){left:2vw;top:3vh;width:90px;height:90px}
.fx span:nth-child(2){left:91vw;top:9vh;width:56px;height:56px}
.fx span:nth-child(3){left:95vw;top:74vh;width:110px;height:110px}
.fx span:nth-child(4){left:72vw;top:2vh;width:40px;height:40px}
.fx span:nth-child(5){left:80vw;top:93vh;width:70px;height:70px}
.fx span:nth-child(6){left:46vw;top:96vh;width:60px;height:60px}
body.theme-day .fx span{background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.9),rgba(255,255,255,.2) 58%,transparent 72%);filter:blur(12px);opacity:.28}
body.theme-sunset .fx span{background:radial-gradient(circle at 35% 30%,rgba(255,240,205,.9),rgba(255,180,95,.35) 58%,transparent 72%);filter:blur(8px);opacity:.4}
body.theme-night .fx span{width:3px;height:3px;background:#dff1ff;filter:none;opacity:.55;box-shadow:0 0 6px #9fd8ff}
.app{position:relative;z-index:1;min-width:1300px;max-width:1780px;margin:0 auto;
  height:100vh;padding:14px 20px 16px}
/* ===== 大外框：占满一屏，内部布局，页面永不滚动 ===== */
.frame{position:relative;height:100%;border-radius:26px;overflow:hidden;
  border:2px solid var(--lg-bd);box-shadow:var(--lg-out);transition:all .6s;
  display:flex;flex-direction:column}
/* ===== ★ 背景：绝对定位钉死在框内，永远不动 ===== */
.stage{position:absolute;inset:0;z-index:0;pointer-events:none}
.stage img{position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;object-position:center 40%;
  filter:var(--img-filter);transition:filter .8s}
.stage .veil{position:absolute;inset:0;background:var(--veil);transition:background .8s}
/* ===== ★ 液态玻璃件（统一配方） ===== */
.g,.pill,.menu-top,.donut::before,.navbar,.sidebar{
  position:relative;
  background:var(--lg-bg);border:1.5px solid var(--lg-bd);
  backdrop-filter:var(--lg-blur);-webkit-backdrop-filter:var(--lg-blur);
  box-shadow:var(--lg-out),var(--lg-inn);transition:all .6s}
.g::before,.navbar::before,.sidebar::before{
  content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:var(--lg-spec);background-size:240% 240%;
  animation:sheen 14s ease-in-out infinite alternate}
@keyframes sheen{from{background-position:0% 0%}to{background-position:100% 100%}}
.g{border-radius:19px}
.pill{border-radius:999px}
/* ===== 导航条：固定在顶部，不滚动 ===== */
.navbar{z-index:6;flex:none;display:flex;align-items:center;
  justify-content:space-between;padding:13px 24px;border-radius:20px;margin:12px 14px 0}
.navbar>* ,.sidebar>*{position:relative;z-index:1}
.g>*{position:relative;z-index:1}
.brand{display:flex;align-items:center;gap:13px}
.logo{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;flex:none;
  background:var(--acc);box-shadow:var(--glow),inset 0 2px 3px rgba(255,255,255,.55);
  font-size:23px;line-height:1;color:#fff}
.brand h1{font-size:21px;font-weight:900;letter-spacing:1.5px}
.nav-right{display:flex;gap:11px}
.pill{display:inline-flex;align-items:center;gap:7px;padding:9px 18px;cursor:pointer;
  font-size:13px;font-family:inherit;font-weight:600;color:var(--text)}
.pill:hover{transform:translateY(-2px) scale(1.03)}
#themeBtn{color:#fff;background:var(--acc);border:none;box-shadow:var(--glow)}
/* ===== 主体：侧栏固定 + 右侧内容区内部滚动 ===== */
.frame-body{position:relative;z-index:2;flex:1;min-height:0;
  display:grid;grid-template-columns:232px 1fr;gap:14px;padding:14px}
/* ===== ★ 侧边栏：完全静止，不跟随滚动 ===== */
.sidebar{border-radius:19px;padding:16px 14px 14px;
  display:flex;flex-direction:column;overflow:hidden auto}
.menu-top{display:flex;align-items:center;gap:10px;width:100%;padding:11px 14px;border-radius:13px;
  cursor:pointer;font-size:14px;font-weight:800;font-family:inherit;color:var(--text);margin-bottom:14px}
.menu-top .mi{background:var(--acc);border-color:transparent;color:#fff;box-shadow:var(--glow)}
.menu-top .chev{margin-left:auto}
.menu a{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:13px;cursor:pointer;
  font-size:13.5px;font-weight:600;color:var(--text);transition:.25s;margin-bottom:4px}
.mi{width:25px;height:25px;border:1.5px solid currentColor;border-radius:50%;
  display:grid;place-items:center;flex:none;font-size:12px;line-height:1;font-style:normal}
.menu .chev{margin-left:auto;font-size:10px;opacity:.55}
.menu a:hover{background:rgba(255,255,255,.5);transform:translateX(3px)}
body.theme-night .menu a:hover{background:rgba(255,255,255,.08)}
.menu a.active{background:var(--acc);color:#fff;font-weight:700;
  box-shadow:var(--glow),inset 0 1.5px 2px rgba(255,255,255,.4)}
.menu a.active .mi{border-color:rgba(255,255,255,.95)}
.side-foot{margin-top:auto;padding:13px 8px 4px;font-size:10.5px;color:var(--sub);
  opacity:.95;line-height:2;border-top:1.5px solid var(--hair)}
/* ===== ★ 滚动区：只有这里滚动，背景与侧栏不动 ===== */
.main{position:relative;min-width:0;overflow-y:auto;overscroll-behavior:contain;
  -webkit-overflow-scrolling:touch;padding-bottom:6px}
.main::-webkit-scrollbar{width:5px}
.main::-webkit-scrollbar-thumb{background:rgba(120,170,230,.4);border-radius:4px}
.main::-webkit-scrollbar-track{background:transparent}
.main-grid{display:grid;grid-template-columns:1fr 306px;gap:16px;min-height:calc(100% - 16px)}
.left-col{display:grid;grid-template-rows:auto 1fr auto;gap:16px}
/* ===== KPI ===== */
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.kpi{padding:15px 19px 13px;position:relative}
.kpi .tag{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--sub);font-weight:500}
.kpi .tag i{width:14px;height:14px;border-radius:4.5px;background:var(--acc);flex:none;box-shadow:var(--glow)}
.kpi .num{font-size:34px;font-weight:900;letter-spacing:.4px;margin:4px 0 7px;font-variant-numeric:tabular-nums}
.kpi .trend{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--green);font-weight:600}
.kpi .trend::before{content:"";width:18px;height:4px;border-radius:2px;background:var(--green)}
.kpi .plus{position:absolute;top:13px;right:13px;width:29px;height:29px;border-radius:50%;border:none;
  cursor:pointer;color:#fff;background:var(--acc);font-size:17px;line-height:1;
  box-shadow:var(--glow),inset 0 1.5px 2px rgba(255,255,255,.5)}
/* ===== 底部行 ===== */
.bottom{display:grid;grid-template-columns:1.42fr 1fr;gap:16px}
.focus{padding:16px 22px 13px}
.focus h3,.todo h3,.pad h3{font-size:15.5px;font-weight:900;display:flex;align-items:center;justify-content:space-between}
.chev{opacity:.45;font-size:12px;font-style:normal}
.odds{display:flex;align-items:center;margin:13px 0 10px}
.odd{flex:1;text-align:center;padding:3px 6px}
.odd+.odd{border-left:1.5px solid var(--hair)}
.odd .k{font-size:11.5px;color:var(--sub);font-weight:600}
.odd .v{font-size:28px;font-weight:900;margin:3px 0}
.odd .s{font-size:10px;color:var(--sub);opacity:.85}
.donut{width:112px;height:112px;border-radius:50%;flex:none;position:relative;margin-left:12px;
  background:conic-gradient(var(--ring2) 0 14%,var(--ring1) 14% 100%);
  box-shadow:var(--glow),inset 0 2px 4px rgba(255,255,255,.4)}
.donut::before{content:"";position:absolute;inset:16px;border-radius:50%}
.donut::after{content:"→";position:absolute;inset:0;display:grid;place-items:center;
  font-size:28px;font-weight:900;color:var(--acc-s);font-style:normal}
.donut .dot{position:absolute;top:6px;right:16px;width:11px;height:11px;border-radius:50%;
  background:#fff;box-shadow:0 0 0 3.5px var(--ring1)}
.mini-stats{display:flex;border-top:1.5px solid var(--hair);padding-top:10px}
.mini-stats div{flex:1;text-align:center}
.mini-stats .k{font-size:10px;color:var(--sub)}
.mini-stats .v{font-size:12.5px;font-weight:800;margin-top:3px}
.mini-stats div+div{border-left:1.5px solid var(--hair)}
.bars{padding:16px 22px;display:flex;flex-direction:column;justify-content:space-around;gap:12px}
.brow{display:flex;align-items:center;gap:11px}
.brow .bl{width:80px;flex:none;font-size:11.5px;color:var(--sub);display:flex;align-items:center;gap:7px}
.brow .bl i{width:7px;height:7px;border-radius:50%;background:var(--acc);flex:none;box-shadow:var(--glow)}
.brow .bar{flex:1}
.brow .bp{width:42px;flex:none;text-align:right;font-size:12.5px;font-weight:800}
.bar{height:8px;border-radius:5px;background:var(--track);overflow:hidden}
.bar i{display:block;height:100%;border-radius:5px;background:var(--acc);transition:width .6s}
/* ===== 右列 ===== */
.rightcol{display:flex;flex-direction:column;gap:13px}
.card{padding:14px 16px}
.sq{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;color:#fff;
  background:var(--acc);flex:none;font-size:18px;box-shadow:var(--glow),inset 0 2px 2px rgba(255,255,255,.5)}
.user-card{display:flex;align-items:center;gap:12px}
.user-card .info{flex:1;min-width:0}
.user-card .lbl{font-size:11.5px;color:var(--sub);margin-bottom:8px}
.stat{display:flex;align-items:center;gap:12px}
.stat .info{flex:1;min-width:0}
.stat .pct{font-size:22px;font-weight:900}
.stat .bar{margin-top:7px}
.todo{flex:1;display:flex;flex-direction:column;min-height:0}
.todo h3 a{font-size:11px;color:var(--sub);text-decoration:none;font-weight:600}
.todo ul{flex:1;list-style:none;margin-top:6px;display:flex;flex-direction:column;justify-content:space-evenly}
.todo li{display:flex;align-items:center;gap:10px;font-size:12px;padding:4px 0}
.todo li::before{content:"";width:9px;height:9px;border-radius:50%;flex:none}
.todo li.y::before{background:var(--dot-y)}.todo li.g::before{background:var(--dot-g)}
/* ===== ★ 下方滚动面板 ===== */
.panel-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}
.panel-row.wide{grid-template-columns:1.6fr 1fr}
.panel-row.single{grid-template-columns:1fr}
.pad{padding:16px 20px 14px}
.lb-row{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--hair);font-size:12.5px}
.lb-row:last-child{border-bottom:none}
.rk{width:21px;height:21px;border-radius:7px;background:var(--track);display:grid;place-items:center;
  font-style:normal;font-weight:800;font-size:11px;flex:none;color:var(--text)}
.lb-row:first-child .rk{background:var(--acc-s);color:#fff;box-shadow:var(--glow)}
.lb-row b{width:60px;font-weight:700;flex:none}
.lb-row .bar{flex:1}
.lb-row em{width:36px;text-align:right;font-style:normal;font-weight:800}
.m-row{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--hair);font-size:12.5px}
.m-row:last-child{border-bottom:none}
.m-row .t{flex:1;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.m-row .t.r{text-align:right}
.sc{font-weight:900;font-size:14px;padding:2px 12px;border-radius:8px;background:var(--track);flex:none}
.st{font-style:normal;font-size:10px;padding:3px 9px;border-radius:999px;flex:none;font-weight:600}
.st.end{background:var(--track);color:var(--sub)}
.st.live{background:rgba(23,178,106,.16);color:var(--green)}
.st.soon{background:rgba(245,168,60,.18);color:var(--dot-y)}
.ai-big{display:flex;align-items:baseline;gap:9px;font-size:13px;color:var(--sub);margin:8px 0 10px}
.ai-big b{font-size:30px;font-weight:900;color:var(--text)}
.ai-tags{display:flex;gap:8px}
.ai-tags span{flex:1;text-align:center;padding:8px 0;border-radius:11px;background:var(--track);
  font-size:11px;font-weight:700}
.ai-tags span.hot{background:var(--acc);color:#fff;box-shadow:var(--glow)}
.ai-tip{font-size:11px;color:var(--sub);line-height:1.8;border-top:1px solid var(--hair);
  padding-top:10px;margin-top:12px}
.hot-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:10px}
.hot{padding:12px 14px;border-radius:14px;background:var(--track)}
.hot .hn{font-size:11.5px;font-weight:700;display:flex;align-items:center;gap:6px}
.hot .hp{font-size:20px;font-weight:900;margin:5px 0 7px}
</style>
</head>
<body class="theme-day">
<div class="fx"><span></span><span></span><span></span><span></span><span></span><span></span></div>
<div class="app">
<div class="frame">
  <!-- ★ 背景：钉死在框内，永不移动（不再用 fixed，bug 根除） -->
  <div class="stage">
    <img src="/app/static/hero_stadium.jpg" alt="" onerror="this.style.display='none'">
    <div class="veil"></div>
  </div>

  <header class="navbar">
    <div class="brand"><span class="logo">⚽</span><h1>足球分析系统</h1></div>
    <div class="nav-right">
      <button class="pill">💬 消息</button>
      <button class="pill">个人中心</button>
      <button class="pill">🚪 退出系统</button>
      <button class="pill" id="themeBtn">🌇 黄昏模式</button>
    </div>
  </header>

  <div class="frame-body">
    <!-- 侧栏：静止，永不滚动 -->
    <aside class="sidebar">
      <button class="menu-top"><span class="mi">👤</span>首页概览<span class="chev">▾</span></button>
      <nav class="menu">
        <a><span class="mi">🏠</span>首页概览<span class="chev">▾</span></a>
        <a class="active"><span class="mi">📊</span>联赛数据<span class="chev">▾</span></a>
        <a><span class="mi">🛡️</span>球队分析<span class="chev">▾</span></a>
        <a><span class="mi">🏃</span>球员分析<span class="chev">▾</span></a>
        <a><span class="mi">📅</span>比赛详情<span class="chev">▾</span></a>
        <a><span class="mi">🎯</span>比赛预测<span class="chev">▾</span></a>
        <a><span class="mi">🤖</span>AI智能分析<span class="chev">▾</span></a>
        <a><span class="mi">⚡</span>实时比分<span class="chev">▾</span></a>
      </nav>
      <div class="side-foot">数据更新时间：2025-06-01 08:00<br>系统版本 v2.4.1 © 足球分析系统</div>
    </aside>

    <!-- ★ 唯一的滚动区：面板从静止的体育场上滑过 -->
    <main class="main">
      <div class="main-grid">
        <div class="left-col">
          <section class="kpis">
            <div class="kpi g"><div class="tag"><i></i>数据总量</div><div class="num">12,698</div><div class="trend">较昨日 ↑ 3.2%</div></div>
            <div class="kpi g"><div class="tag"><i></i>覆盖赛事</div><div class="num">11,315</div><div class="trend">较昨日 ↑ 2.1%</div></div>
