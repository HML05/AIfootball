</div>
<script>
const ORDER=['theme-day','theme-sunset','theme-night'],LABEL={'theme-day':'☀️ 白天模式','theme-sunset':'🌇 黄昏模式','theme-night':'🌃 夜晚模式'},btn=document.getElementById('themeBtn');
function apply(c){document.body.classList.remove(...ORDER);document.body.classList.add(c);btn.textContent=LABEL[c];localStorage.setItem('fx-theme',c)}
btn.onclick=()=>{const i=ORDER.findIndex(c=>document.body.classList.contains(c));apply(ORDER[(i+1)%ORDER.length])};
apply(localStorage.getItem('fx-theme')||'theme-day');
</script>
</body></html>