# ═══════════════════════════════════════════════════════════════════════════════
# 服务器路线（docker compose）用的变量模板
#   用法：copy deploy\.env.example deploy\.env   然后按需填写
#   deploy/.env 已被 .gitignore 的 `.env` 规则覆盖，不会进仓库
# ═══════════════════════════════════════════════════════════════════════════════

# ── 域名与证书 ────────────────────────────────────────────────────────────────
# 有域名就填域名（Caddy 会自动申请 HTTPS）；暂时没域名就留空，Caddy 退化成 :80
DOMAIN=
# 可选的证书通知邮箱（同时在 Caddyfile 里启用全局 email 块）
ACME_EMAIL=

# ── 大模型问答（不填则自动降级为检索摘要，界面仍然可用）─────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ── 数据源（公网演示不需要，留空即可；填了且开了定时任务才会去抓）────────────
API_SPORTS_KEY=
FOOTBALL_DATA_TOKEN=
QIXIAOCE_API_KEY=
